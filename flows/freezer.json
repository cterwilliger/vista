    {
        "id": "71abdeb3.9091d",
        "type": "function",
        "z": "d5acb2a.2ea075",
        "name": "decode fahenheit",
        "func": "// {\"ddmp\":[0,0,1,1,1,86,255]}\n\nvar arr = msg.payload.ddmp;\n\nif ( arr[0] === 0 & \n     arr[1] === 0 & \n     arr[2] === 1 &\n     arr[3] === 1 &\n     arr[4] === 1 )\n     {\n         var temp = (arr[5] - 81) / 5;\n         msg = { payload: temp};\n         return msg;\n     }\n\nreturn;",
        "outputs": 1,
        "noerr": 0,
        "x": 790,
        "y": 400,
        "wires": [
