    {
        "id": "e06c47bc.3418d8",
        "type": "function",
        "z": "d5acb2a.2ea075",
        "d": true,
        "name": "CFX3 Startup",
        "func": "// Startup message handler for Dometic CFX3 Cooler\n\n// send {2] - seems to be a connection request\nvar connectMsg = Buffer.from([0x7B, 0x22, 0x64, 0x64, 0x6D, 0x70, 0x22, 0x3A, 0x5B, 0x32, 0x5D, 0x7D, 0x0D]);\n\n// send [4] - seems to be an acknowledgment to a received message from the cooler\nvar ackMsg = Buffer.from([0x7B, 0x22, 0x64, 0x64, 0x6D, 0x70, 0x22, 0x3A, 0x5B, 0x34, 0x5D, 0x7D, 0x0D]);\n\n// send [1,1,0,0,129] - seems to be some sort of configuration.  Once this is sent, the cooler starts sending data\nvar configMsg = Buffer.from([0x7B, 0x22, 0x64, 0x64, 0x6D, 0x70, 0x22, 0x3A, 0x5B, 0x31, 0x2c, 0x31, 0x2c, 0x30, 0x2c, 0x30, 0x2c, 0x31, 0x32, 0x39, 0x5D, 0x7D, 0x0D]);\n\n//msg.host = \"192.168.10.116\" \n//msg.port = \"13142\"\n\nvar arr = msg.payload.ddmp;\n\nswitch(context.get(\"state\")) {\n  case \"start\":\n    msg = {payload:connectMsg};\n    node.send(msg);\n    context.set(\"state\", \"connectRequested\");\n    node.done();\n    break;\n  case \"connectRequested\":\n    msg = {payload:configMsg};\n    node.send(msg);\n    context.set(\"state\", \"run\");\n    node.done();\n    break;\n  case \"run\":\n    if ( arr[0] === 6 ) // timeout?\n    {\n        msg = {payload:connectMsg};\n        context.set(\"state\", \"connectRequested\")\n    }    \n    else\n    {\n        msg = {payload:ackMsg};\n    }\n    node.send(msg);\n    node.done();\n    break;\n default:\n    // code block\n}\n\n\n\n\n\n\n\n\n\n\n\n//if ( ( context.get(\"state\") === \"start\" ) || ( msg.payload == \"XX\" ) )\n\nreturn;\n\n",
        "outputs": 1,
        "noerr": 0,
        "initialize": "// Code added here will be run once\n// whenever the node is deployed.\ncontext.set(\"state\", \"start\");",
        "finalize": "",
        "x": 340,
        "y": 440,
        "wires": [
            []
        ]
    },
